# Copy to .env.local and fill in.
# Spotify only accepts loopback IPs for dev redirect URIs, so open the app at http://127.0.0.1:3000 (not localhost).
APP_URL=http://127.0.0.1:3000

# Set to 1 to use built-in fake Spotify/Apple catalogs (no developer accounts needed). MongoDB is still required.
MOCK_MUSIC=0

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tunebridge

# Spotify: https://developer.spotify.com/dashboard → Create app → Web API
# Redirect URI: http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music: Apple Developer Program → Certificates, IDs & Profiles → Keys → MusicKit
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Either a path to the .p8 file or its contents with \n line breaks
APPLE_PRIVATE_KEY_PATH=./keys/AuthKey_XXXXXXXXXX.p8
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_DEFAULT_STOREFRONT=us

# YouTube Music: Google Cloud → enable YouTube Data API v3
# API key reads public playlists; the OAuth client (scope "youtube") lets users create playlists and like songs.
# OAuth redirect URI: http://127.0.0.1:3000/api/auth/youtube/callback
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify "house" account: lets visitors get Spotify playlists without signing in (see README).
# ADMIN_KEY guards /api/admin/spotify-house, which stores the house account's sign-in.
ADMIN_KEY=
# Off switches: set to 1 to stop using the house account, or to stop reading public playlists from Spotify's embed page.
SPOTIFY_HOUSE_DISABLED=0
SPOTIFY_EMBED_DISABLED=0

# Gemini (optional): finds songs the search missed and checks close matches. Without it they go to manual review.
# Falls back to gemini-3.5-flash-lite when this model is busy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Tiger Data / TimescaleDB (optional; transfer events always go to MongoDB `events` too)
TIGER_DATABASE_URL=
